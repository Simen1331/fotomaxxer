 "prep_sql": "UPDATE processing_state SET status = 'done' WHERE stage = 'ai' AND image_id NOT IN (1, 4, 5, 7, 8, 10, 15, 29);\nUPDATE images SET place_name = 'Bø i Telemark', gps_lat = 59.4105, gps_lon = 9.0678 WHERE id % 7 = 0;\nUPDATE images SET place_name = 'Ål', gps_lat = 60.6297, gps_lon = 8.5615 WHERE id % 11 = 0 AND place_name IS NULL;\nUPDATE images SET place_name = 'Oslo', gps_lat = 59.9139, gps_lon = 10.7522 WHERE id % 13 = 0 AND place_name IS NULL;\nUPDATE images SET place_name = '' WHERE id = 50;\nUPDATE images SET place_name = 'Æsøya_100%', gps_lat = 0.0000001, gps_lon = -0.0000535 WHERE id = 51;\nUPDATE images SET gps_lat = 1e16, gps_lon = 123456789.125 WHERE id = 52;\nUPDATE images SET gps_lat = -0.0, gps_lon = 0 WHERE id = 53;\nUPDATE images SET taken_at = NULL, year = NULL, season = NULL WHERE id IN (3, 9, 27, 400);\nUPDATE images SET season = 'vår' WHERE id % 17 = 0 AND season IS NOT NULL;\nUPDATE images SET year = 1999 WHERE id = 60;\nUPDATE images SET camera_make = NULL, camera_model = NULL, width = NULL, height = NULL WHERE id = 6;\nUPDATE images SET excluded = 1 WHERE id IN (2, 14, 21, 63);\nUPDATE images SET excluded = 1 WHERE id = (SELECT image_id FROM faces GROUP BY image_id ORDER BY COUNT(*) DESC, image_id LIMIT 1);\nINSERT INTO sources (id, root_path) VALUES (2, '/finnes/ikke/kopi');\nINSERT INTO files (image_id, source_id, path) SELECT id, 2, '/finnes/ikke/kopi/kopi-' || id || '.jpg' FROM images WHERE id IN (100, 103);\nINSERT INTO files (image_id, source_id, path) SELECT (SELECT image_id FROM faces GROUP BY image_id ORDER BY COUNT(*) DESC, image_id LIMIT 1), 2, '/finnes/ikke/kopi/flest-ansikter.jpg';\nINSERT INTO ai_tags (image_id, provider, scene, event_type, season_ai, indoor_outdoor, person_count, description, cost, tagged_at) VALUES (100, 'openrouter:test/handlaget', 'strand', 'ferie', 'sommer', 'outdoor', 3, 'Tre personer på stranda i Bø, 100% sol', 0.0000535, '2026-10-01 10:00:00'), (100, 'openrouter:test/handlaget', 'hytte', 'bursdag', 'sommer', 'indoor', 2, 'Eldre merking som ikke skal vises', 0.0001, '2026-09-01 10:00:00'), (101, 'openrouter:test/handlaget', 'fjell', 'tur', 'høst', 'outdoor', 0, 'Fjelltur over Ålfjell med ørret i bekken', NULL, '2026-10-01 10:00:00'), (102, 'openrouter:test/handlaget', NULL, NULL, NULL, NULL, NULL, NULL, NULL, '2026-10-01 10:00:00'), (103, 'openrouter:test/handlaget', 'stue', 'jul', 'vinter', 'indoor', 5, 'Julaften i stua_med «sitater» og \"anførsel\"', NULL, '2026-10-01 10:00:00'), (104, 'openrouter:test/handlaget', 'stue', 'jul', 'vinter', 'indoor', 1, 'Pakker under treet', NULL, '2026-10-01 10:00:00'), (105, 'openrouter:test/handlaget', 'strand', 'ferie', 'sommer', 'outdoor', 2, 'STRAND med store bokstaver', NULL, '2026-10-01 10:00:00'), (106, 'openrouter:test/handlaget', 'hage', 'Bursdag', 'vår', 'Outdoor', 4, 'Hage i mai', NULL, '2026-10-01 10:00:00'), (107, 'openrouter:test/handlaget', '', '', '', '', 0, '', NULL, '2026-10-01 10:00:00'), (14, 'openrouter:test/handlaget', 'skjult', 'skjult-hendelse', 'sommer', 'outdoor', 1, 'Ekskludert bilde', NULL, '2026-10-01 10:00:00');\nINSERT INTO tags (id, name, category) VALUES (901, 'strand', NULL), (902, 'ørret', 'mat'), (903, 'Ål', 'sted'), (904, '100%', 'annet'), (905, 'under_strek', NULL), (906, 'jul', 'hendelse'), (907, 'skjult-tagg', NULL), (908, 'Strand', NULL);\nINSERT INTO image_tags (image_id, tag_id) VALUES (100, 901), (100, 904), (100, 903), (105, 901), (105, 908), (101, 902), (101, 903), (103, 906), (103, 905), (104, 906), (14, 907), (14, 901);\nUPDATE persons SET name = 'Åse' WHERE cluster_id = (SELECT cluster_id FROM faces WHERE cluster_id IS NOT NULL GROUP BY cluster_id ORDER BY COUNT(*) DESC, cluster_id LIMIT 1 OFFSET 0);\nUPDATE persons SET name = 'Bjørn' WHERE cluster_id = (SELECT cluster_id FROM faces WHERE cluster_id IS NOT NULL GROUP BY cluster_id ORDER BY COUNT(*) DESC, cluster_id LIMIT 1 OFFSET 1);\nUPDATE persons SET name = 'ærlig' WHERE cluster_id = (SELECT cluster_id FROM faces WHERE cluster_id IS NOT NULL GROUP BY cluster_id ORDER BY COUNT(*) DESC, cluster_id LIMIT 1 OFFSET 3);\nUPDATE persons SET name = 'Zorro' WHERE cluster_id = (SELECT cluster_id FROM faces WHERE cluster_id IS NOT NULL GROUP BY cluster_id ORDER BY COUNT(*) ASC, cluster_id LIMIT 1 OFFSET 0);\nUPDATE persons SET name = 'Anne' WHERE cluster_id = (SELECT cluster_id FROM faces WHERE cluster_id IS NOT NULL GROUP BY cluster_id ORDER BY COUNT(*) ASC, cluster_id LIMIT 1 OFFSET 2);\nUPDATE faces SET locked = 1 WHERE id % 40 = 0;",
