    {"method": "PUT", "path": "/api/sources"},
    {"method": "OPTIONS", "path": "/api/sources"},
    {"method": "POST", "path": "/api/sources/"},
    {"method": "GET", "path": "/api"},
    {"method": "GET", "path": "/nope"},
    {"method": "POST", "path": "/nope"},
    {"method": "OPTIONS", "path": "/nope"},

    {"name": "SPA: indeks", "method": "GET", "path": "/"},
    {"name": "SPA: HEAD gir 405", "method": "HEAD", "path": "/"},
    {"name": "SPA: index.html", "method": "GET", "path": "/index.html"},
    {"name": "SPA: klientrute", "method": "GET", "path": "/personer/12"},
    {"name": "SPA: ukjent fil gir indeks", "method": "GET", "path": "/favicon.ico"},
    {"name": "SPA: /assets uten skråstrek", "method": "GET", "path": "/assets"},
    {"name": "SPA: /assets/ er mappe", "method": "GET", "path": "/assets/"},
    {"name": "SPA: JS-asset", "method": "GET", "path": "/assets/{asset_js}"},
    {"name": "SPA: CSS-asset", "method": "GET", "path": "/assets/{asset_css}"},
    {"name": "SPA: HEAD asset", "method": "HEAD", "path": "/assets/{asset_css}"},
    {"name": "SPA: 304 på egen ETag", "method": "GET", "path": "/assets/{asset_css}", "headers": {"If-None-Match": "W/\"x\", {etag}"}, "expect_status": 304},
    {"name": "SPA: 304 på If-Modified-Since", "method": "GET", "path": "/assets/{asset_js}", "headers": {"If-Modified-Since": "Fri, 01 Jan 2100 00:00:00 GMT"}, "expect_status": 304},
    {"name": "SPA: 200 på gammel If-Modified-Since", "method": "GET", "path": "/assets/{asset_js}", "headers": {"If-Modified-Since": "Thu, 01 Jan 1970 00:00:00 GMT"}, "expect_status": 200},
    {"name": "SPA: fil i dist utenfor assets", "method": "GET", "path": "/assets/../assets/{asset_css}"},
