    {"name": "/derived POST", "method": "POST", "path": "/derived/x.jpg"},
    {"name": "/derived utenfor", "method": "GET", "path": "/derived/../fotomaxxer.db"},

    {"name": "422: tekst i heltall (spørring)", "method": "GET", "path": "/api/progress?source_id=abc"},
    {"name": "422: tom spørreverdi", "method": "GET", "path": "/api/progress?source_id="},
    {"name": "lax: 1.0 som heltall", "method": "GET", "path": "/api/progress?source_id=1.0"},
    {"name": "lax: mellomrom og _", "method": "GET", "path": "/api/progress?source_id=%201_0%20"},
    {"name": "siste verdi vinner", "method": "GET", "path": "/api/progress?source_id=1&source_id=x"},
    {"name": "500: heltall utenfor SQLite", "method": "GET", "path": "/api/progress?source_id=99999999999999999999"},
    {"name": "422: sti", "method": "PATCH", "path": "/api/sources/abc", "json": {"profile_id": null}},
    {"name": "422: sti + kropp samlet", "method": "PATCH", "path": "/api/sources/1.5", "json": {"profile_id": "x"}},
    {"name": "422: manglende kropp", "method": "PATCH", "path": "/api/sources/1"},
