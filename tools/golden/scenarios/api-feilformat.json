    {"name": "SPA: asset utenfor", "method": "GET", "path": "/assets/../index.html"},
    {"name": "SPA: POST mot asset", "method": "POST", "path": "/assets/finnes-ikke.js"},
    {"name": "SPA: prosentkodet sti", "method": "GET", "path": "/s%C3%B8k%20her"},
    {"name": "SPA: /derived uten skråstrek", "method": "GET", "path": "/derived"},
