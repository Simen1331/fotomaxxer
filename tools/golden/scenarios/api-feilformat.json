    {"name": "json_invalid: komma", "method": "PATCH", "path": "/api/sources/1", "body": "{\"a\": 1,}", "headers": {"Content-Type": "application/json"}},
    {"name": "json_invalid: liste-komma", "method": "PATCH", "path": "/api/sources/1", "body": "[1,]", "headers": {"Content-Type": "application/json"}},
    {"name": "json_invalid: kolon", "method": "PATCH", "path": "/api/sources/1", "body": "{\"a\" 1}", "headers": {"Content-Type": "application/json"}},
    {"name": "json_invalid: ekstra data", "method": "PATCH", "path": "/api/sources/1", "body": "{\"a\": 1} x", "headers": {"Content-Type": "application/json"}},
    {"name": "json_invalid: uavsluttet streng", "method": "PATCH", "path": "/api/sources/1", "body": "\"abc", "headers": {"Content-Type": "application/json"}},
    {"name": "json_invalid: æøå før feil", "method": "PATCH", "path": "/api/sources/1", "body": "{\"æøå\": [1, }", "headers": {"Content-Type": "application/json"}},
    {"name": "json_invalid: bare mellomrom", "method": "PATCH", "path": "/api/sources/1", "body": " ", "headers": {"Content-Type": "application/json"}},
    {"name": "422: tom JSON-kropp", "method": "PATCH", "path": "/api/sources/1", "body": "", "headers": {"Content-Type": "application/json"}},
    {"name": "JSON med +json og charset", "method": "PATCH", "path": "/api/sources/1", "body": "{\"profile_id\": 1}", "headers": {"Content-Type": "application/vnd.x+json; charset=utf-8"}},
    {"name": "HTTPException 404 fra ruter", "method": "PATCH", "path": "/api/sources/1", "json": {"profile_id": null}},
    {"name": "422: manglende felt", "method": "POST", "path": "/api/sources", "json": {}},
    {"name": "422: tall som streng", "method": "POST", "path": "/api/sources", "json": {"path": 12}},
    {"name": "422: null som streng", "method": "POST", "path": "/api/sources", "json": {"path": null}},
    {"name": "422: flyttall som heltall", "method": "POST", "path": "/api/sources", "json": {"path": "/x", "profile_id": 1.5}},
    {"name": "lax: true som heltall", "method": "POST", "path": "/api/sources", "json": {"path": "/finnes-ikke", "profile_id": true}},
    {"name": "lax: '7' som heltall", "method": "POST", "path": "/api/sources", "json": {"path": "/finnes-ikke", "profile_id": "7"}},
    {"name": "422: liste-type", "method": "POST", "path": "/api/profiles", "json": {"name": "A", "categories": "x"}},
    {"name": "422: elementfeil i liste", "method": "POST", "path": "/api/profiles", "json": {"name": "A", "categories": [1, "b", null]}},
    {"name": "422: flere felt i rekkefølge", "method": "POST", "path": "/api/profiles", "json": {"focus": 3, "ekstra": true}},
    {"name": "422: bool og heltall", "method": "POST", "path": "/api/jobs/tag", "json": {"retag": "yes", "limit": "abc", "workers": 2.5}},
    {"name": "422: bool_parsing tall", "method": "POST", "path": "/api/jobs/tag", "json": {"retag": 2}},
    {"name": "422: bool_parsing tekst", "method": "POST", "path": "/api/jobs/tag", "json": {"retag": "kanskje"}},
    {"name": "422: bool_type flyttall", "method": "POST", "path": "/api/jobs/faces-cluster", "json": {"full": 0.5}},
    {"name": "422: bool_type null", "method": "POST", "path": "/api/jobs/faces-cluster", "json": {"full": null}},
    {"name": "422: data-dir bool", "method": "POST", "path": "/api/maintenance/data-dir", "json": {"path": "/x", "delete_source": "nei"}},
    {"name": "422: settings verdi", "method": "PUT", "path": "/api/settings/ai_model", "json": {"value": 5}},
    {"name": "422: settings manglende verdi", "method": "PUT", "path": "/api/settings/ai_model", "json": {}},
    {"name": "400: ukjent setting", "method": "PUT", "path": "/api/settings/bad_key", "json": {"value": "x"}},
    {"name": "400: ugyldig UTF-8 i JSON", "method": "PATCH", "path": "/api/sources/1", "body_latin1": "{\"profile_id\": \"\u00e6\"}", "headers": {"Content-Type": "application/json"}},
    {"name": "404: ukjent kilde", "method": "DELETE", "path": "/api/sources/77", "json": {}},
    {"name": "404: ukjent profil", "method": "DELETE", "path": "/api/profiles/77", "json": {}},
    {"method": "GET", "path": "/api/jobs/current"},
    {"method": "GET", "path": "/api/cost"},
    {"method": "GET", "path": "/api/progress"}
