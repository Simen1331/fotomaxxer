{
  "beskrivelse": "Innstillinger, nøkkelmaskering, default_profile_id, datamappe (les, flytt, flytt med sletting, feil) og klargjøring for deling",
  "steps": [
    {"method": "GET", "path": "/api/settings"},
    {"method": "GET", "path": "/api/maintenance/data-dir"},
    {"method": "PUT", "path": "/api/settings/ai_model", "json": {"value": "test/modell"}},
    {"method": "PUT", "path": "/api/settings/face_match_threshold", "json": {"value": "0.55"}},
    {"method": "PUT", "path": "/api/settings/face_min_cluster_size", "json": {"value": "4"}},
    {"method": "PUT", "path": "/api/settings/default_export_dir", "json": {"value": "{work}/eksport æøå"}},
    {"name": "kort nøkkel maskeres helt", "method": "PUT", "path": "/api/settings/openrouter_api_key", "json": {"value": "kort"}},
    {"name": "lang nøkkel maskeres", "method": "PUT", "path": "/api/settings/openrouter_api_key", "json": {"value": "sk-or-v1-abcdefghijkl"}},
    {"name": "nøkkel med æøå", "method": "PUT", "path": "/api/settings/openrouter_api_key", "json": {"value": "æøå-nøkkel-åæø"}},
    {"name": "default_profile_id heltall", "method": "PUT", "path": "/api/settings/default_profile_id", "json": {"value": "3"}},
    {"name": "default_profile_id med mellomrom", "method": "PUT", "path": "/api/settings/default_profile_id", "json": {"value": " 7 "}},
    {"name": "default_profile_id med _", "method": "PUT", "path": "/api/settings/default_profile_id", "json": {"value": "1_0"}},
    {"name": "default_profile_id 1.0 er ugyldig", "method": "PUT", "path": "/api/settings/default_profile_id", "json": {"value": "1.0"}},
    {"name": "default_profile_id tekst", "method": "PUT", "path": "/api/settings/default_profile_id", "json": {"value": "x"}},
    {"name": "default_profile_id tom", "method": "PUT", "path": "/api/settings/default_profile_id", "json": {"value": ""}},
    {"name": "ukjent nøkkel", "method": "PUT", "path": "/api/settings/hemmelig", "json": {"value": "x"}},
    {"name": "tom verdi", "method": "PUT", "path": "/api/settings/ai_model", "json": {"value": ""}},
    {"method": "GET", "path": "/api/settings"},

    {"name": "flytt datamappa (beholder gammel)", "method": "POST", "path": "/api/maintenance/data-dir", "json": {"path": "{work}/flyttet æøå"}},
    {"method": "GET", "path": "/api/maintenance/data-dir"},
    {"check_files": "{work}/flyttet æøå"},
    {"check_files": "{pakke}"},
    {"name": "innstillingene følger med", "method": "GET", "path": "/api/settings"},
    {"name": "skriv i ny mappe", "method": "PUT", "path": "/api/settings/ai_model", "json": {"value": "etter/flytting"}},
    {"name": "flytt til samme mappe er no-op", "method": "POST", "path": "/api/maintenance/data-dir", "json": {"path": "{work}/flyttet æøå", "delete_source": true}},
    {"name": "flytt under en fil feiler", "method": "POST", "path": "/api/maintenance/data-dir", "json": {"path": "{home}/fil.txt/barn"}},
    {"method": "GET", "path": "/api/maintenance/data-dir"},
    {"name": "flytt med sletting", "method": "POST", "path": "/api/maintenance/data-dir", "json": {"path": "{work}/andre", "delete_source": true}},
    {"check_files": "{work}/flyttet æøå"},
    {"check_files": "{work}/andre"},
    {"method": "GET", "path": "/api/settings"},
    {"name": "flytt med ~ i stien", "method": "POST", "path": "/api/maintenance/data-dir", "json": {"path": "~/datamappe {impl}"}},
    {"check_files": "{home}/datamappe {impl}"},
    {"name": "flytt tilbake ut av HOME", "method": "POST", "path": "/api/maintenance/data-dir", "json": {"path": "{work}/tredje", "delete_source": true}},
    {"check_files": "{home}/datamappe {impl}"},

    {"name": "klargjør for deling", "method": "POST", "path": "/api/maintenance/prepare-handoff", "json": {}},
    {"name": "nøkkelen er borte", "method": "GET", "path": "/api/settings"},
    {"name": "klargjør igjen (tom)", "method": "POST", "path": "/api/maintenance/prepare-handoff"}
  ]
}
