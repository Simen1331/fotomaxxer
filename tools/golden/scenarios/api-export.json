   "exec_sql": "INSERT INTO albums (id, name, created_at) VALUES (1, 'Sommer på hytta 2011', '2026-10-01 10:00:00'), (2, 'Ærlig talt: «Ørret» & Åse!', '2026-10-01 10:00:00'), (3, '..', '2026-10-01 10:00:00'), (4, 'Tomt album', '2026-10-01 10:00:00'), (5, 'a/b\\c 🙂', '2026-10-01 10:00:00'), (6, '  .skjult.  ', '2026-10-01 10:00:00');INSERT INTO album_items (album_id, image_id, position) SELECT 1, id, (id * 7) % 5 FROM images WHERE id <= 12;INSERT INTO album_items (album_id, image_id, position) SELECT 2, id, -id FROM images WHERE id BETWEEN 20 AND 24;INSERT INTO album_items (album_id, image_id, position) VALUES (3, 30, 0), (3, 31, 0), (5, 3, 2), (5, 40, 1), (6, 41, 0), (6, {img_dup}, 1);UPDATE files SET path = path || '.borte' WHERE id = (SELECT MIN(id) FROM files WHERE image_id = 3);UPDATE files SET path = path || '.borte' WHERE id = (SELECT MIN(id) FROM files WHERE image_id = {img_dup});",
   "name": "album og manglende originaler"
