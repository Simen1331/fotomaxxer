{
  "beskrivelse": "Personer på en kopi av py-golden (38 personer, 649 ansikter, noen bilder ekskludert): liste/cover, rutenett, bilder med paginering, navn med æøå og tomme navn, splitt, flytt/lås/lås opp ansikter (delvis kropp), sammenslåing (også med seg selv), sletting og ignorering, 404/405/422 — så inkrementell og full klynging som må respektere låste ansikter og navn",
  "seed_dir": "~/dev/fotomaxxer-testlib/py-golden",
  "prep_sql": "UPDATE images SET excluded = 1 WHERE id = (SELECT image_id FROM faces WHERE cluster_id = (SELECT cluster_id FROM faces WHERE cluster_id IS NOT NULL GROUP BY cluster_id ORDER BY COUNT(*) DESC, cluster_id LIMIT 1) ORDER BY id LIMIT 1); UPDATE images SET excluded = 1 WHERE id IN (SELECT image_id FROM faces WHERE cluster_id = (SELECT cluster_id FROM faces WHERE cluster_id IS NOT NULL GROUP BY cluster_id ORDER BY COUNT(*), cluster_id LIMIT 1));",
  "steps": [
    {"var": "big", "sql": "SELECT cluster_id FROM faces WHERE cluster_id IS NOT NULL GROUP BY cluster_id ORDER BY COUNT(*) DESC, cluster_id LIMIT 1"},
    {"var": "p2", "sql": "SELECT cluster_id FROM faces WHERE cluster_id IS NOT NULL GROUP BY cluster_id ORDER BY COUNT(*) DESC, cluster_id LIMIT 1 OFFSET 1"},
    {"var": "p3", "sql": "SELECT cluster_id FROM faces WHERE cluster_id IS NOT NULL GROUP BY cluster_id ORDER BY COUNT(*) DESC, cluster_id LIMIT 1 OFFSET 2"},
    {"var": "p4", "sql": "SELECT cluster_id FROM faces WHERE cluster_id IS NOT NULL GROUP BY cluster_id ORDER BY COUNT(*) DESC, cluster_id LIMIT 1 OFFSET 3"},
    {"var": "p5", "sql": "SELECT cluster_id FROM faces WHERE cluster_id IS NOT NULL GROUP BY cluster_id ORDER BY COUNT(*) DESC, cluster_id LIMIT 1 OFFSET 4"},
    {"var": "small", "sql": "SELECT cluster_id FROM faces WHERE cluster_id IS NOT NULL GROUP BY cluster_id ORDER BY COUNT(*), cluster_id LIMIT 1"},
    {"var": "t1", "sql": "SELECT cluster_id FROM faces WHERE cluster_id IS NOT NULL GROUP BY cluster_id HAVING COUNT(*) = 4 ORDER BY cluster_id LIMIT 1 OFFSET 0"},
    {"var": "t2", "sql": "SELECT cluster_id FROM faces WHERE cluster_id IS NOT NULL GROUP BY cluster_id HAVING COUNT(*) = 4 ORDER BY cluster_id LIMIT 1 OFFSET 1"},
    {"var": "t3", "sql": "SELECT cluster_id FROM faces WHERE cluster_id IS NOT NULL GROUP BY cluster_id HAVING COUNT(*) = 4 ORDER BY cluster_id LIMIT 1 OFFSET 2"},
    {"var": "n1", "sql": "SELECT id FROM faces WHERE cluster_id IS NULL ORDER BY id LIMIT 1 OFFSET 0"},
    {"var": "n2", "sql": "SELECT id FROM faces WHERE cluster_id IS NULL ORDER BY id LIMIT 1 OFFSET 1"},
    {"var": "n3", "sql": "SELECT id FROM faces WHERE cluster_id IS NULL ORDER BY id LIMIT 1 OFFSET 2"},
    {"var": "n4", "sql": "SELECT id FROM faces WHERE cluster_id IS NULL ORDER BY id LIMIT 1 OFFSET 3"},
    {"var": "bigtop", "sql": "SELECT MAX(id) FROM faces WHERE cluster_id = (SELECT cluster_id FROM faces WHERE cluster_id IS NOT NULL GROUP BY cluster_id ORDER BY COUNT(*) DESC, cluster_id LIMIT 1)"},
    {"var": "bigtop2", "sql": "SELECT id FROM faces WHERE cluster_id = (SELECT cluster_id FROM faces WHERE cluster_id IS NOT NULL GROUP BY cluster_id ORDER BY COUNT(*) DESC, cluster_id LIMIT 1) ORDER BY id DESC LIMIT 1 OFFSET 1"},
    {"var": "p4face", "sql": "SELECT MIN(id) FROM faces WHERE cluster_id = (SELECT cluster_id FROM faces WHERE cluster_id IS NOT NULL GROUP BY cluster_id ORDER BY COUNT(*) DESC, cluster_id LIMIT 1 OFFSET 3)"},
    {"var": "p5face", "sql": "SELECT MIN(id) FROM faces WHERE cluster_id = (SELECT cluster_id FROM faces WHERE cluster_id IS NOT NULL GROUP BY cluster_id ORDER BY COUNT(*) DESC, cluster_id LIMIT 1 OFFSET 4)"},

    {"name": "personliste før kuratering (ekskluderte skjult)", "method": "GET", "path": "/api/persons"},
    {"name": "rutenett for største person", "method": "GET", "path": "/api/persons/{big}/faces"},
    {"name": "person med bare ekskluderte bilder: tomt rutenett", "method": "GET", "path": "/api/persons/{small}/faces"},
    {"name": "… og ingen bilder", "method": "GET", "path": "/api/persons/{small}/images"},
    {"name": "rutenett ukjent person (404)", "method": "GET", "path": "/api/persons/999999/faces", "expect_status": 404},
    {"name": "rutenett tekst-id (422)", "method": "GET", "path": "/api/persons/abc/faces", "expect_status": 422},
    {"name": "bilder standardside", "method": "GET", "path": "/api/persons/{big}/images"},
    {"name": "bilder side 1", "method": "GET", "path": "/api/persons/{big}/images", "query": {"limit": 5}},
    {"name": "bilder side 2", "method": "GET", "path": "/api/persons/{big}/images", "query": {"limit": 5, "offset": 5}},
    {"name": "bilder siste side", "method": "GET", "path": "/api/persons/{big}/images", "query": {"limit": 1000, "offset": 60}},
    {"name": "bilder etter slutten", "method": "GET", "path": "/api/persons/{big}/images", "query": {"offset": 100000}},
    {"name": "bilder: andre filtre ignoreres", "method": "GET", "path": "/api/persons/{big}/images", "query": {"limit": 3, "year": 1999, "include_excluded": true, "person": 1, "q": "strand", "tag": "x"}},
    {"name": "bilder: lax heltall", "method": "GET", "path": "/api/persons/{big}/images", "query": {"limit": "2.0", "offset": " 3 "}},
    {"name": "bilder limit=0 (422)", "method": "GET", "path": "/api/persons/{big}/images", "query": {"limit": 0}, "expect_status": 422},
    {"name": "bilder limit=1001 (422)", "method": "GET", "path": "/api/persons/{big}/images", "query": {"limit": 1001}, "expect_status": 422},
    {"name": "bilder offset=-1 og limit=abc (422)", "method": "GET", "path": "/api/persons/{big}/images", "query": {"offset": -1, "limit": "abc"}, "expect_status": 422},
    {"name": "bilder tom limit (422)", "method": "GET", "path": "/api/persons/{big}/images?limit=", "expect_status": 422},
    {"name": "bilder ukjent person (404)", "method": "GET", "path": "/api/persons/999999/images", "expect_status": 404},
    {"name": "bilder ugyldig sti og spørring (422)", "method": "GET", "path": "/api/persons/x/images", "query": {"limit": 0}, "expect_status": 422},
    {"name": "heltall utenfor i64 (500)", "method": "GET", "path": "/api/persons/99999999999999999999/faces", "expect_status": 500},

    {"name": "navngi største (trim, æøå)", "method": "PUT", "path": "/api/persons/{big}", "json": {"name": "  Bjørn Ærlig Åsen  "}},
    {"name": "navngi p2", "method": "PUT", "path": "/api/persons/{p2}", "json": {"name": "Åse"}},
    {"name": "navngi p3", "method": "PUT", "path": "/api/persons/{p3}", "json": {"name": "øystein"}},
    {"name": "navngi t1", "method": "PUT", "path": "/api/persons/{t1}", "json": {"name": "Zelda"}},
    {"name": "navngi t2", "method": "PUT", "path": "/api/persons/{t2}", "json": {"name": "Æsa"}},
    {"name": "navngi t3", "method": "PUT", "path": "/api/persons/{t3}", "json": {"name": "Anne"}},
    {"name": "navn med Python-mellomrom (\\x1f/\\x1c)", "method": "PUT", "path": "/api/persons/{p5}", "json": {"name": "\u001f Kari　\u001c"}},
    {"name": "personliste med navn (sortering ved likt antall)", "method": "GET", "path": "/api/persons"},
    {"name": "tomt navn → null", "method": "PUT", "path": "/api/persons/{p3}", "json": {"name": "   "}},
    {"name": "tom streng → null", "method": "PUT", "path": "/api/persons/{p3}", "json": {"name": ""}},
    {"name": "name=null", "method": "PUT", "path": "/api/persons/{p3}", "json": {"name": null}},
    {"name": "tom kropp {} → null", "method": "PUT", "path": "/api/persons/{p3}", "json": {}},
    {"name": "ukjent felt ignoreres", "method": "PUT", "path": "/api/persons/{p3}", "json": {"name": "Øystein", "ukjent": 1}},
    {"name": "omdøp ukjent person (404)", "method": "PUT", "path": "/api/persons/999999", "json": {"name": "Ingen"}, "expect_status": 404},
    {"name": "omdøp tekst-id (422)", "method": "PUT", "path": "/api/persons/abc", "json": {"name": "x"}, "expect_status": 422},
    {"name": "navn som tall (422)", "method": "PUT", "path": "/api/persons/{p3}", "json": {"name": 5}, "expect_status": 422},
    {"name": "omdøp uten kropp (422)", "method": "PUT", "path": "/api/persons/{p3}", "expect_status": 422},
    {"name": "omdøp med tekstkropp (422)", "method": "PUT", "path": "/api/persons/{p3}", "body": "Øystein", "expect_status": 422},
    {"name": "omdøp med liste (422)", "method": "PUT", "path": "/api/persons/{p3}", "json": ["Øystein"], "expect_status": 422},
    {"name": "GET på /persons/{id} (404 fra SPA-ruten)", "method": "GET", "path": "/api/persons/{p3}", "expect_status": 404},
    {"name": "PATCH på /persons/{id} (405)", "method": "PATCH", "path": "/api/persons/{p3}", "expect_status": 405},

    {"name": "splitt: ny person av to uklyngede ansikter", "method": "POST", "path": "/api/persons", "body": "{\"name\": \"  Ny Person Ørn \", \"face_ids\": [{n1}, {n2}]}", "headers": {"Content-Type": "application/json"}},
    {"var": "newp", "sql": "SELECT MAX(cluster_id) FROM persons"},
    {"name": "rutenett for ny person", "method": "GET", "path": "/api/persons/{newp}/faces"},
    {"name": "splitt uten navn (id-er som tekst, lax)", "method": "POST", "path": "/api/persons", "json": {"face_ids": ["{n3}"]}},
    {"var": "newp2", "sql": "SELECT MAX(cluster_id) FROM persons"},
    {"name": "splitt med blankt navn og ansikt fra annen person", "method": "POST", "path": "/api/persons", "body": "{\"name\": \"   \", \"face_ids\": [{n4}, {bigtop2}, {n4}]}", "headers": {"Content-Type": "application/json"}},
    {"var": "newp3", "sql": "SELECT MAX(cluster_id) FROM persons"},
    {"name": "splitt med tom liste (400)", "method": "POST", "path": "/api/persons", "json": {"face_ids": []}, "expect_status": 400},
    {"name": "splitt med ukjent ansikt (400)", "method": "POST", "path": "/api/persons", "json": {"face_ids": [999999]}, "expect_status": 400},
    {"name": "splitt med ett kjent og ett ukjent (400, ingenting endres)", "method": "POST", "path": "/api/persons", "body": "{\"name\": \"Skal ikke finnes\", \"face_ids\": [{p5face}, 999999]}", "headers": {"Content-Type": "application/json"}, "expect_status": 400},
    {"name": "splitt uten face_ids (422)", "method": "POST", "path": "/api/persons", "json": {"name": "x"}, "expect_status": 422},
    {"name": "splitt med face_ids som tekst (422)", "method": "POST", "path": "/api/persons", "json": {"face_ids": "1"}, "expect_status": 422},
    {"name": "splitt med ugyldige elementer (422)", "method": "POST", "path": "/api/persons", "json": {"name": 1, "face_ids": [1.5, "a", 2]}, "expect_status": 422},
    {"name": "splitt uten kropp (422)", "method": "POST", "path": "/api/persons", "expect_status": 422},
    {"name": "PATCH /persons (405)", "method": "PATCH", "path": "/api/persons", "expect_status": 405},
    {"name": "personliste etter splitt", "method": "GET", "path": "/api/persons"},

    {"name": "lås ansikt (cover endres)", "method": "PUT", "path": "/api/faces/{bigtop}", "json": {"locked": true}},
    {"name": "personliste: låst ansikt er cover", "method": "GET", "path": "/api/persons"},
    {"name": "flytt ansikt til eksisterende person", "method": "PUT", "path": "/api/faces/{bigtop2}", "body": "{\"cluster_id\": {p2}}", "headers": {"Content-Type": "application/json"}},
    {"name": "flytt til ny person og lås", "method": "PUT", "path": "/api/faces/{bigtop2}", "body": "{\"cluster_id\": {newp}, \"locked\": true}", "headers": {"Content-Type": "application/json"}},
    {"name": "ignorer søppel-ansikt (løsne + lås)", "method": "PUT", "path": "/api/faces/{p4face}", "json": {"cluster_id": null, "locked": true}},
    {"name": "lås opp (bare locked)", "method": "PUT", "path": "/api/faces/{p4face}", "json": {"locked": false}},
    {"name": "lås med \"yes\" (lax)", "method": "PUT", "path": "/api/faces/{p4face}", "json": {"locked": "yes"}},
    {"name": "locked=null låser opp", "method": "PUT", "path": "/api/faces/{p4face}", "json": {"locked": null}},
    {"name": "tilbake til p4 (id som tekst)", "method": "PUT", "path": "/api/faces/{p4face}", "json": {"cluster_id": "{p4}"}},
    {"name": "flytt til ukjent person + lås (404, ikke låst)", "method": "PUT", "path": "/api/faces/{p5face}", "json": {"cluster_id": 999999, "locked": true}, "expect_status": 404},
    {"name": "lås ukjent ansikt (404)", "method": "PUT", "path": "/api/faces/999999", "json": {"locked": true}, "expect_status": 404},
    {"name": "løsne ukjent ansikt (404)", "method": "PUT", "path": "/api/faces/999999", "json": {"cluster_id": null}, "expect_status": 404},
    {"name": "tom patch (400)", "method": "PUT", "path": "/api/faces/{p5face}", "json": {}, "expect_status": 400},
    {"name": "patch med bare ukjente felt (400)", "method": "PUT", "path": "/api/faces/{p5face}", "json": {"ukjent": true}, "expect_status": 400},
    {"name": "patch ugyldig sti og kropp (422)", "method": "PUT", "path": "/api/faces/abc", "json": {"locked": "kanskje", "cluster_id": "x"}, "expect_status": 422},
    {"name": "patch uten kropp (422)", "method": "PUT", "path": "/api/faces/{p5face}", "expect_status": 422},
    {"name": "POST /faces/{id} (405)", "method": "POST", "path": "/api/faces/{p5face}", "expect_status": 405},
    {"name": "rutenett største (låst flagg)", "method": "GET", "path": "/api/persons/{big}/faces"},
    {"name": "rutenett ny person (flyttet + låst)", "method": "GET", "path": "/api/persons/{newp}/faces"},
    {"name": "rutenett p2 (fikk og mistet ansiktet)", "method": "GET", "path": "/api/persons/{p2}/faces"},
    {"name": "rutenett p4 (ansiktet er tilbake)", "method": "GET", "path": "/api/persons/{p4}/faces"},
    {"name": "rutenett p5 (uendret etter 404)", "method": "GET", "path": "/api/persons/{p5}/faces"},

    {"name": "slå sammen med seg selv (400)", "method": "POST", "path": "/api/persons/{p3}/merge", "body": "{\"into_cluster_id\": {p3}}", "headers": {"Content-Type": "application/json"}, "expect_status": 400},
    {"name": "slå sammen ukjent kilde (400)", "method": "POST", "path": "/api/persons/999999/merge", "body": "{\"into_cluster_id\": {big}}", "headers": {"Content-Type": "application/json"}, "expect_status": 400},
    {"name": "slå sammen inn i ukjent (400)", "method": "POST", "path": "/api/persons/{p3}/merge", "json": {"into_cluster_id": 999999}, "expect_status": 400},
    {"name": "slå sammen uten mål (422)", "method": "POST", "path": "/api/persons/{p3}/merge", "json": {}, "expect_status": 422},
    {"name": "slå sammen ugyldig sti og kropp (422)", "method": "POST", "path": "/api/persons/abc/merge", "json": {"into_cluster_id": "x"}, "expect_status": 422},
    {"name": "slå sammen t1 inn i navngitt største", "method": "POST", "path": "/api/persons/{t1}/merge", "body": "{\"into_cluster_id\": {big}}", "headers": {"Content-Type": "application/json"}},
    {"name": "slå sammen navngitt p3 inn i unavngitt (navn null)", "method": "POST", "path": "/api/persons/{p3}/merge", "json": {"into_cluster_id": "{newp2}"}},
    {"name": "sammenslått kilde finnes ikke (404)", "method": "GET", "path": "/api/persons/{t1}/faces", "expect_status": 404},
    {"name": "rutenett etter sammenslåing", "method": "GET", "path": "/api/persons/{newp2}/faces"},
    {"name": "personliste etter sammenslåing", "method": "GET", "path": "/api/persons"},

    {"name": "slett p2", "method": "DELETE", "path": "/api/persons/{p2}"},
    {"name": "slett p2 igjen (404)", "method": "DELETE", "path": "/api/persons/{p2}", "expect_status": 404},
    {"name": "slett tekst-id (422)", "method": "DELETE", "path": "/api/persons/abc", "expect_status": 422},
    {"name": "bilder for slettet person (404)", "method": "GET", "path": "/api/persons/{p2}/images", "expect_status": 404},
    {"name": "ignorer t3", "method": "POST", "path": "/api/persons/{t3}/ignore"},
    {"name": "ignorer t3 igjen (404)", "method": "POST", "path": "/api/persons/{t3}/ignore", "expect_status": 404},
    {"name": "ignorer tekst-id (422)", "method": "POST", "path": "/api/persons/abc/ignore", "expect_status": 422},
    {"name": "ignorer person med bare ekskluderte bilder", "method": "POST", "path": "/api/persons/{small}/ignore"},
    {"name": "ignorer splitten med ett ansikt", "method": "POST", "path": "/api/persons/{newp3}/ignore"},
    {"name": "GET på /ignore (404 fra SPA-ruten)", "method": "GET", "path": "/api/persons/{p4}/ignore", "expect_status": 404},
    {"name": "GET på /faces/{id} (404 fra SPA-ruten)", "method": "GET", "path": "/api/faces/{p5face}", "expect_status": 404},
    {"name": "personliste etter sletting og ignorering", "method": "GET", "path": "/api/persons"},
    {"name": "fremdrift etter kuratering", "method": "GET", "path": "/api/progress"},

    {"name": "inkrementell klynging etter kuratering", "method": "POST", "path": "/api/jobs/faces-cluster", "json": {}, "expect_status": 202, "wait": true},
    {"name": "jobbstatus inkrementell", "method": "GET", "path": "/api/jobs/current"},
    {"name": "personliste etter inkrementell", "method": "GET", "path": "/api/persons"},
    {"name": "rutenett største etter inkrementell", "method": "GET", "path": "/api/persons/{big}/faces"},
    {"name": "full klynging (navn og låste respekteres)", "method": "POST", "path": "/api/jobs/faces-cluster", "json": {"full": true}, "expect_status": 202, "wait": true},
    {"name": "jobbstatus full", "method": "GET", "path": "/api/jobs/current"},
    {"name": "personliste etter full klynging", "method": "GET", "path": "/api/persons"},
    {"name": "største beholder det låste ansiktet", "method": "GET", "path": "/api/persons/{big}/faces"},
    {"name": "ny person beholder det låste ansiktet", "method": "GET", "path": "/api/persons/{newp}/faces"},
    {"name": "bilder for største etter full klynging", "method": "GET", "path": "/api/persons/{big}/images", "query": {"limit": 3}},
    {"name": "fremdrift til slutt", "method": "GET", "path": "/api/progress"}
  ]
}
