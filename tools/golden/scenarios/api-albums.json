{
  "beskrivelse": "Album på en kopi av py-golden: opprett (trim, æøå, tomt navn), liste (nyeste først), detalj, legg til (posisjoner, duplikater, ukjente id-er, idempotent, ekskludert bilde, samme bilde i to album), omorganiser (ukjente id-er, duplikater, delvis liste), fjern element, slett med cascade, tomt album, 404/405/422",
  "seed_dir": "~/dev/fotomaxxer-testlib/py-golden",
  "prep_sql": "UPDATE images SET excluded = 1 WHERE id = (SELECT id FROM images ORDER BY id LIMIT 1 OFFSET 6);",
  "steps": [
    {"var": "i1", "sql": "SELECT id FROM images ORDER BY id LIMIT 1 OFFSET 0"},
    {"var": "i2", "sql": "SELECT id FROM images ORDER BY id LIMIT 1 OFFSET 1"},
    {"var": "i3", "sql": "SELECT id FROM images ORDER BY id LIMIT 1 OFFSET 2"},
    {"var": "i4", "sql": "SELECT id FROM images ORDER BY id LIMIT 1 OFFSET 3"},
    {"var": "i5", "sql": "SELECT id FROM images ORDER BY id LIMIT 1 OFFSET 4"},
    {"var": "i6", "sql": "SELECT id FROM images ORDER BY id LIMIT 1 OFFSET 5"},
    {"var": "ex", "sql": "SELECT id FROM images WHERE excluded = 1"},

    {"name": "ingen album", "method": "GET", "path": "/api/albums"},
    {"name": "opprett med trim og æøå", "method": "POST", "path": "/api/albums", "json": {"name": "  Sommer på Hvaler – 2011  "}},
    {"var": "a1", "sql": "SELECT MAX(id) FROM albums"},
    {"name": "opprett med spesialtegn", "method": "POST", "path": "/api/albums", "json": {"name": "Ærfugl, øyer & «skjær»"}},
    {"var": "a2", "sql": "SELECT MAX(id) FROM albums"},
    {"name": "opprett tomt album", "method": "POST", "path": "/api/albums", "json": {"name": "Tomt album", "ukjent": true}},
    {"var": "a3", "sql": "SELECT MAX(id) FROM albums"},
    {"name": "blankt navn (400)", "method": "POST", "path": "/api/albums", "json": {"name": "   "}, "expect_status": 400},
    {"name": "tom streng (400)", "method": "POST", "path": "/api/albums", "json": {"name": ""}, "expect_status": 400},
    {"name": "bare Python-mellomrom (400)", "method": "POST", "path": "/api/albums", "json": {"name": "\u001f 　"}, "expect_status": 400},
    {"name": "uten navn (422)", "method": "POST", "path": "/api/albums", "json": {}, "expect_status": 422},
    {"name": "navn null (422)", "method": "POST", "path": "/api/albums", "json": {"name": null}, "expect_status": 422},
    {"name": "navn som tall (422)", "method": "POST", "path": "/api/albums", "json": {"name": 5}, "expect_status": 422},
    {"name": "uten kropp (422)", "method": "POST", "path": "/api/albums", "expect_status": 422},
    {"name": "tekstkropp (422)", "method": "POST", "path": "/api/albums", "body": "Sommer", "expect_status": 422},
    {"name": "liste: nyeste først, tomme", "method": "GET", "path": "/api/albums"},
    {"name": "tomt album", "method": "GET", "path": "/api/albums/{a3}"},
    {"name": "ukjent album (404)", "method": "GET", "path": "/api/albums/999999", "expect_status": 404},
    {"name": "album 0 (404)", "method": "GET", "path": "/api/albums/0", "expect_status": 404},
    {"name": "tekst-id (422)", "method": "GET", "path": "/api/albums/abc", "expect_status": 422},

    {"name": "legg til: duplikater og ukjente hoppes over", "method": "POST", "path": "/api/albums/{a1}/items", "body": "{\"image_ids\": [{i3}, {i1}, {i3}, 999999, {i2}, -1, 0]}", "headers": {"Content-Type": "application/json"}},
    {"name": "legg til: idempotent + ekskludert bilde", "method": "POST", "path": "/api/albums/{a1}/items", "body": "{\"image_ids\": [{i1}, {i4}, {ex}]}", "headers": {"Content-Type": "application/json"}},
    {"name": "legg til tom liste", "method": "POST", "path": "/api/albums/{a1}/items", "json": {"image_ids": []}},
    {"name": "legg til med id som tekst (lax)", "method": "POST", "path": "/api/albums/{a1}/items", "json": {"image_ids": ["{i5}"]}},
    {"name": "samme bilde i to album", "method": "POST", "path": "/api/albums/{a2}/items", "body": "{\"image_ids\": [{i1}, {i6}]}", "headers": {"Content-Type": "application/json"}},
    {"name": "legg til i ukjent album (404)", "method": "POST", "path": "/api/albums/999999/items", "json": {"image_ids": [1]}, "expect_status": 404},
    {"name": "image_ids som tekst (422)", "method": "POST", "path": "/api/albums/{a1}/items", "json": {"image_ids": "1"}, "expect_status": 422},
    {"name": "ugyldige elementer (422)", "method": "POST", "path": "/api/albums/{a1}/items", "json": {"image_ids": [1, "a", 2.5]}, "expect_status": 422},
    {"name": "uten image_ids (422)", "method": "POST", "path": "/api/albums/{a1}/items", "json": {}, "expect_status": 422},
    {"name": "ugyldig sti og null-liste (422)", "method": "POST", "path": "/api/albums/abc/items", "json": {"image_ids": null}, "expect_status": 422},
    {"name": "detalj etter tillegg", "method": "GET", "path": "/api/albums/{a1}"},
    {"name": "liste med antall", "method": "GET", "path": "/api/albums"},

    {"name": "omorganiser: ukjent id og duplikat", "method": "PATCH", "path": "/api/albums/{a1}/order", "body": "{\"image_ids\": [{i4}, 999999, {i2}, {i4}]}", "headers": {"Content-Type": "application/json"}},
    {"name": "omorganiser: full reversering", "method": "PATCH", "path": "/api/albums/{a1}/order", "body": "{\"image_ids\": [{i5}, {ex}, {i4}, {i2}, {i1}, {i3}]}", "headers": {"Content-Type": "application/json"}},
    {"name": "omorganiser: delvis liste", "method": "PATCH", "path": "/api/albums/{a1}/order", "body": "{\"image_ids\": [{i3}, {i1}]}", "headers": {"Content-Type": "application/json"}},
    {"name": "omorganiser: tom liste", "method": "PATCH", "path": "/api/albums/{a1}/order", "json": {"image_ids": []}},
    {"name": "omorganiser tomt album", "method": "PATCH", "path": "/api/albums/{a3}/order", "body": "{\"image_ids\": [{i1}]}", "headers": {"Content-Type": "application/json"}},
    {"name": "omorganiser ukjent album (404)", "method": "PATCH", "path": "/api/albums/999999/order", "json": {"image_ids": []}, "expect_status": 404},
    {"name": "omorganiser med tekst (422)", "method": "PATCH", "path": "/api/albums/{a1}/order", "json": {"image_ids": "x"}, "expect_status": 422},
    {"name": "omorganiser uten kropp (422)", "method": "PATCH", "path": "/api/albums/{a1}/order", "expect_status": 422},
    {"name": "GET på /order (404 «ukjent endepunkt» fra SPA-ruten)", "method": "GET", "path": "/api/albums/{a1}/order", "expect_status": 404},

    {"name": "fjern element", "method": "DELETE", "path": "/api/albums/{a1}/items/{i3}"},
    {"name": "fjern samme igjen (200, uendret)", "method": "DELETE", "path": "/api/albums/{a1}/items/{i3}"},
    {"name": "fjern bilde som ikke finnes", "method": "DELETE", "path": "/api/albums/{a1}/items/999999"},
    {"name": "fjern fra ukjent album (404)", "method": "DELETE", "path": "/api/albums/999999/items/{i1}", "expect_status": 404},
    {"name": "fjern med tekst-id (422)", "method": "DELETE", "path": "/api/albums/{a1}/items/abc", "expect_status": 422},
    {"name": "fjern med to tekst-id-er (422)", "method": "DELETE", "path": "/api/albums/x/items/y", "expect_status": 422},
    {"name": "legg til etter fjerning (etter høyeste posisjon)", "method": "POST", "path": "/api/albums/{a1}/items", "body": "{\"image_ids\": [{i3}, {i6}]}", "headers": {"Content-Type": "application/json"}},
    {"name": "detalj etter fjerning og tillegg", "method": "GET", "path": "/api/albums/{a1}"},
    {"name": "GET på /items (404 fra SPA-ruten)", "method": "GET", "path": "/api/albums/{a1}/items", "expect_status": 404},
    {"name": "PUT på /items (405)", "method": "PUT", "path": "/api/albums/{a1}/items", "expect_status": 405},
    {"name": "PUT /albums (405)", "method": "PUT", "path": "/api/albums", "expect_status": 405},
    {"name": "PUT /albums/{id} (405)", "method": "PUT", "path": "/api/albums/{a1}", "expect_status": 405},
    {"name": "HEAD /albums/{id} (405)", "method": "HEAD", "path": "/api/albums/{a1}", "expect_status": 405},
    {"name": "liste før sletting", "method": "GET", "path": "/api/albums"},

    {"name": "slett album 2", "method": "DELETE", "path": "/api/albums/{a2}"},
    {"name": "slett album 2 igjen (404)", "method": "DELETE", "path": "/api/albums/{a2}", "expect_status": 404},
    {"name": "slettet album (404)", "method": "GET", "path": "/api/albums/{a2}", "expect_status": 404},
    {"name": "slett tekst-id (422)", "method": "DELETE", "path": "/api/albums/abc", "expect_status": 422},
    {"name": "bildet i album 2 er fortsatt i album 1", "method": "GET", "path": "/api/albums/{a1}"},
    {"name": "nytt album etter sletting", "method": "POST", "path": "/api/albums", "json": {"name": "Nytt etter sletting"}},
    {"name": "liste til slutt", "method": "GET", "path": "/api/albums"}
  ]
}
